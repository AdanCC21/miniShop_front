# This value is compiled into the browser bundle. The browser, not the frontend
# EC2 instance, calls the API. Use the public HTTPS URL when deploying.
NG_APP_BACKEND_ROUTE=http://localhost:3000
# Production example: NG_APP_BACKEND_ROUTE=https://api.example.com
FRONTEND_PORT=8080
# Keep localhost for a local reverse proxy; use 0.0.0.0 behind an AWS ALB.
HOST_BIND_IP=127.0.0.1
